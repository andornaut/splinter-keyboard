#!/bin/sh
set -eu

action=${1:-check}
case "$action" in check|lint|test) ;; *) exit 2 ;; esac
if [ "$action" != test ]; then
    python -m venv /scratch/venv
    /scratch/venv/bin/python -m pip install --disable-pip-version-check -r requirements-dev.txt
    /scratch/venv/bin/ruff check .
    /scratch/venv/bin/ruff format --check .
fi
if [ "$action" != lint ]; then
    version=$(python -c 'import json; print(json.load(open("package.json"))["config"]["VERSION"])')
    npm_package_config_VERSION="$version" exec python scripts/validate-provenance.py
fi
