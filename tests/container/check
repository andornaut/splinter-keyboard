#!/bin/sh
set -eu

mode=${1:-check}
shift || true
if [ ! -e node_modules ]; then
    if [ "${CHECK_WRITABLE:-0}" = 1 ]; then
        cp -R /opt/node-deps/node_modules node_modules
    else
        ln -s /opt/node-deps/node_modules node_modules
    fi
fi

lint() {
    npm run lint:internal
    find . \( -path ./node_modules -o -path ./ergogen -o -path ./.husky \) -prune -o \
        -type f -name '*.sh' -print0 | xargs -0 -r shellcheck -x -P SCRIPTDIR
    shellcheck -x -P SCRIPTDIR tests/container/run tests/container/check
    ruff check .
    ruff format --check .
    /opt/check-tools/node_modules/.bin/markdownlint-cli2
}

test_suite() {
    npm run validate:provenance -- "$@"
}

case "$mode" in
    check) lint; test_suite ;;
    lint) lint ;;
    test) test_suite "$@" ;;
    build) printf '%s\n' 'No build check declared' >&2; exit 2 ;;
    exec)
        if [ "$#" -gt 0 ]; then exec "$@"; fi
        exec sh -ec "${COMMAND:?COMMAND must be provided}"
        ;;
    *) printf '%s\n' "Unknown check category: $mode" >&2; exit 2 ;;
esac
